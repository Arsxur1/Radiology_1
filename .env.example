# ─── Общие ────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=medviz
TZ=Asia/Tashkent
# Режим установки по умолчанию (RESEARCH | SHADOW | ASSIST). Этап 1 — RESEARCH.
DEFAULT_OPERATING_MODE=RESEARCH
# Контур установки. На продуктивном сервере — production: обучение здесь
# технически запрещено (FR-10 п. 3). На отдельном обучающем сервере — training.
MEDVIZ_CONTOUR=production
# Каталог весов моделей на продуктивном сервере: <weights_hash>.pt (хеш проверяется).
MEDVIZ_MODELS_DIR=/data/models
# Зависимости реального инференса в воркере: пусто (заглушка) или [infer] (torch).
WORKER_EXTRAS=

# ─── PostgreSQL (доверенный контур, метаданные) ─────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=medviz
POSTGRES_USER=medviz
POSTGRES_PASSWORD=change_me_postgres
# Роль только для append-only записи в аудит (без UPDATE/DELETE на audit_log)
POSTGRES_AUDIT_USER=medviz_audit
POSTGRES_AUDIT_PASSWORD=change_me_audit

# ─── Идентифицирующий контур (таблица сопоставления ID↔UUID, SR-9) ───────────
# Отдельная БД, физически/логически изолированная от доверенного контура.
IDMAP_POSTGRES_HOST=postgres-idmap
IDMAP_POSTGRES_PORT=5432
IDMAP_POSTGRES_DB=medviz_idmap
IDMAP_POSTGRES_USER=medviz_idmap
IDMAP_POSTGRES_PASSWORD=change_me_idmap

# ─── Объектное хранилище (S3) ───────────────────────────────────────────────
# По умолчанию — SeaweedFS (chrislusf/seaweedfs:4.48): образ minio/minio больше не
# публикуется на Docker Hub. Ключи ниже — ключи доступа к S3 (анонимный доступ закрыт).
# Свой образ MinIO: MINIO_IMAGE=... и docker-compose.minio.yml (см. PILOT-NCMC.md).
# S3_IMAGE=chrislusf/seaweedfs:4.48
MINIO_ROOT_USER=medviz
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_IMAGES=images
MINIO_BUCKET_MASKS=masks
MINIO_BUCKET_MESHES=meshes
MINIO_SECURE=false

# ─── Orthanc ────────────────────────────────────────────────────────────────
# raw — приём с идентифицирующими данными; clean — обезличенный контур
ORTHANC_RAW_URL=http://orthanc-raw:8042
ORTHANC_CLEAN_URL=http://orthanc-clean:8042
ORTHANC_USERNAME=medviz
ORTHANC_PASSWORD=change_me_orthanc

# ─── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Keycloak (OIDC / RBAC) ─────────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=medviz
KEYCLOAK_CLIENT_ID=medviz-backend
KEYCLOAK_CLIENT_SECRET=change_me_keycloak
# Внешний адрес Keycloak, по которому ходят браузеры врачей (IP/имя сервера платформы).
# После изменения: make keycloak-configure — пропишет адрес в клиенты входа.
KEYCLOAK_PUBLIC_URL=https://localhost/auth
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_kc_admin
# БД учётных записей сотрудников (postgres-keycloak): переживает обновления Keycloak.
KEYCLOAK_DB_PASSWORD=change_me_kc_db

# ─── Backend ────────────────────────────────────────────────────────────────
BACKEND_SECRET_KEY=change_me_secret
BACKEND_CORS_ORIGINS=http://localhost:3000
# Удалять исходник с персональными данными из orthanc-raw после обезличивания (SR-9).
# Оригинал остаётся в PACS клиники. false — хранить (например, на время отладки приёма).
RAW_DELETE_AFTER_INGEST=true
# Кодировка текста DICOM, если аппарат не указал SpecificCharacterSet и текст не UTF-8
# (кириллица Windows на аппаратах из СНГ). Другие варианты: koi8_r, iso8859_5.
DICOM_FALLBACK_CHARSET=cp1251
# Автоанализ серии стартует через столько секунд после её последнего среза.
ANALYSIS_DELAY_SECONDS=20
# Резервный путь приёма (FR-1): папка, куда падают файлы аппаратов без Storage SCU
INGEST_WATCH_DIR=/data/ingest
LOG_LEVEL=INFO
# Разрешить dev-заголовки X-Debug-Subject/X-Debug-Roles (ТОЛЬКО изолированные стенды!).
# В продакшне оставить false — иначе аутентификацию можно обойти заголовком.
ALLOW_DEBUG_AUTH=false

# ─── Внешний PACS клиники (FR-1) ────────────────────────────────────────────
# Заполните по параметрам вашего PACS (см. docs/PACS-INTEGRATION.md). Пусто —
# коннектор PACS не активен, приём по-прежнему работает через C-STORE/папку.
PACS_AET=              # AE Title вашего PACS, напр. PACSSERVER
PACS_HOST=             # IP PACS в сети клиники, напр. 192.168.1.50 (или 127.0.0.1)
PACS_PORT=             # DICOM-порт, обычно 104 или 11112
PACS_LOCAL_AET=MEDVIZ_RAW      # наш приёмный AE (совпадает с orthanc-raw)
PACS_DICOMWEB_URL=     # если PACS поддерживает DICOMweb, напр. http://192.168.1.50:8042/dicom-web
PACS_DIRECTION=push    # push (PACS шлёт нам) | pull (мы забираем)
